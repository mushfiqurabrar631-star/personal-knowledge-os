    <string name="onboarding_1_title">আপনার সব জ্ঞান, এক জায়গায়</string>
    <string name="onboarding_1_body">ফেসবুক পোস্ট, ইউটিউব ভিডিও, ওয়েবসাইট, স্ক্রিনশট, মেসেজ বা ফাইল—যা দেখছেন তা সেভ করুন। PKOS নিজেই বিষয় অনুযায়ী সাজিয়ে রাখবে, পরে সহজে খুঁজে পাবেন।</string>
    <string name="onboarding_2_title">আগে ফোনে, তারপর ক্লাউডে</string>
    <string name="onboarding_2_body">প্রতিটি তথ্য আগে আপনার ফোনেই সেভ হয়—ইন্টারনেট না থাকলেও। ব্যাকআপ আর Notion সিঙ্ক আপনি চালু করলে তবেই হবে, আর কী কোথায় আছে তা সবসময় দেখতে পাবেন।</string>
    <string name="onboarding_2_point_1">ইন্টারনেট ছাড়াই সেভ ও খোঁজা</string>
    <string name="onboarding_2_point_2">ক্লাউড AI ডিফল্টভাবে বন্ধ</string>
    <string name="onboarding_2_point_3">কোনো পেইড সার্ভিস অজান্তে ব্যবহার হয় না</string>
    <string name="onboarding_3_title">অনুমতি শুধু দরকার হলে</string>
    <string name="onboarding_3_body">Share মেনু দিয়ে সেভ করতে কোনো বিশেষ অনুমতি লাগে না। ভাসমান বোতাম চালু করতে চাইলে তখনই কারণ বুঝিয়ে অনুমতি চাওয়া হবে। PKOS অন্য অ্যাপের লেখা নিজে থেকে পড়ে না।</string>

