<?xml version="1.0" encoding="utf-8"?>
<!-- Android's own cloud backup is disabled: PKOS backs up through its own encrypted Drive backup (M5),
     so personal knowledge is never copied unencrypted by the system. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
